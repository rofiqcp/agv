# ESC serial may be disabled while keeping ROS interfaces alive; disabled always reports READY=false.
esc_ackermann:
  ros__parameters:
    teleop_estop_topic: /teleop/emergency_stop_latched
    hmi_topic: /hmi/cmd_vel
    hmi_source_topic: /hmi/active_source
    router_source_topic: /navigation/cmd_mux/source
    hmi_timeout_sec: 0.30
    output_topic: /cmd_vel/actuator
    autonomy_gate_topic: /system/autonomy_motion_allowed
    global_estop_topic: /safety/estop
    command_rate_hz: 50.0
    teleop_timeout_sec: 0.3
    nav2_timeout_sec: 0.6
    manual_release_hold_sec: 1.0
    speed_max: 1.00
    serial_left_max_deg: 90.0
    drive_erpm_per_mps: 8000.0
    # Applied live after N2.1 GNSS/RPM calibration: V_ground = V_raw_ESC * scale.
    wheelbase_m: 0.7
    track_width_m: 0.48
    min_speed_for_nav_steering_mps: 0.05
    yaw_rate_feedback_enabled: true
    yaw_rate_feedback_imu_topic: /imu/data
    yaw_rate_feedback_kp_deg_per_rps: 2.0
    yaw_rate_feedback_ki_deg_per_rad: 0.30
    yaw_rate_feedback_integral_limit_deg: 2.0
    yaw_rate_feedback_correction_limit_deg: 4.0
    yaw_rate_feedback_timeout_sec: 0.25
    yaw_rate_feedback_min_speed_mps: 0.10
    yaw_rate_setpoint_slew_rps2: 1.0
    yaw_rate_feedback_deadband_rps: 0.01
    invert_steering: false
    invert_drive: false
    # ROS-side steering calibration. F103/VESC external LEFT position remains raw 0..360.
    # These are raw VESC POS readings at physical -30/0/+30 deg (operational references).
    steering_vesc_pos_left_deg: 0.0
    steering_vesc_pos_center_deg: 180.0
    steering_vesc_pos_right_deg: 360.0
    steering_vesc_pos_reference_deg: 30.0
    steering_vesc_pos_calibration_saved_at: ''
    steering_feedback_calibration_enabled: true
    steering_feedback_center_deg: -25.84
    steering_feedback_right_stop_deg: 90.0
    steering_feedback_left_stop_deg: -90.0
    steering_feedback_force_symmetric_span: false
    steering_straight_deadband_deg: 1.0
    steering_center_hold_enabled: true
    steering_center_hold_request_deadband_deg: 0.75
    steering_center_hold_capture_deg: 35.0
    steering_center_hold_feedback_deadband_deg: 1.0
    steering_center_hold_kp: 0.18
    steering_center_hold_adapt_gain_per_sec: 1.5
    steering_center_hold_ki: 0.0
    steering_center_hold_integral_limit_deg_s: 0.0
    steering_center_hold_max_trim_deg: 18.0
    steering_center_hold_trim_rate_deg_s: 60.0
    steering_center_hold_latch_inside_deadband: true
    steering_center_hold_feedback_timeout_sec: 0.3
    diagnostic_trace_hz: 2.0
    steering_feedback_calibration_saved_at: 2026-08-22T16:57:26-V8.2-ROS-ONLY-MEASURED
    steering_calibration_mode_enabled: false
    steering_calibration_direct_limit_deg: 90.0
    steering_feedback_left_reference_deg: -155.78
    steering_feedback_center_reference_deg: -14.14
    steering_feedback_right_reference_deg: 60.56000000000001
    steering_physical_calibration_enabled: true
    # Hardware span calibration 2026-09-17: measured hard-stop span=4457 counts.
    # F103 runtime-safe span=3762 counts (~84.4% of hard-stop); that safe span is
    # deliberately exposed to ROS as -30..+30 deg. Extrapolated hard-stop is
    # about +/-35.5 deg and is COMMISSIONING REFERENCE ONLY, never a motion limit.
    steering_physical_left_limit_deg: -30.0
    steering_physical_right_limit_deg: 30.0
    steering_physical_operational_limit_deg: 30.0
    steering_physical_calibration_saved_at: ''
    steering_physical_lut_enabled: false
    steering_lut_physical_deg:
    - -30.0
    - -15.0
    - 0.0
    - 15.0
    - 30.0
    steering_lut_command_increasing_deg:
    - -90.0
    - -45.0
    - 0.0
    - 45.0
    - 90.0
    steering_lut_command_decreasing_deg:
    - -90.0
    - -45.0
    - 0.0
    - 45.0
    - 90.0
    steering_lut_feedback_increasing_deg:
    - -90.0
    - -45.0
    - 0.0
    - 45.0
    - 90.0
    steering_lut_feedback_decreasing_deg:
    - -90.0
    - -45.0
    - 0.0
    - 45.0
    - 90.0
    steering_lut_direction_deadband_deg: 0.15
    steering_lut_calibration_saved_at: ''
    steering_center_bias_from_left_deg: 0.0
    steering_center_bias_from_right_deg: 0.0
    steering_calibration_apply_token: V8.2:1787392646867559142
    # Production transport: F103 USART3 -> dedicated USB-UART -> package esc.
    # F411/stmf4 is sensor/HMI-only and never carries actuator bytes.
    serial_auto_id_contains: 1a86_USB_Serial
    serial_auto_path_contains: ""
    serial_baud: 921600
    serial_tx_rate_hz: 50.0
    serial_reconnect_sec: 0.25
    serial_ack_timeout_sec: 0.6
    command_watchdog_sec: 0.25
    odom_topic: /esc/odom
    odom_validation_topic: /esc/odom_validation
    odom_frame: odom
    base_frame: base_footprint
    odom_v_variance_base: 0.03
    odom_v_variance_erpm_error_gain: 0.2
    wheel_slip_topic: /localization/wheel_slip
    wheel_slip_timeout_sec: 0.75
    wheel_slip_covariance_multiplier: 25.0
    odom_yaw_variance_base: 0.08
    odom_yaw_variance_steer_gain: 0.3
    odom_yaw_rate_variance_base: 0.05

    # Runtime routing and commissioning authority. These were previously hidden in launch/C++ defaults.
    maintenance_owner_topic: /esc/vesc/maintenance_owner
    perception_state_topic: /navigation/trajectory_safety_state
    perception_state_timeout_sec: 0.75
    raw_commissioning_enabled: false
    raw_commissioning_topic: /esc/commissioning/raw_actuator
    raw_commissioning_timeout_sec: 0.25
    raw_commissioning_max_erpm: 8000.0
    raw_commissioning_max_steering_deg: 30.0
    integration_bypass: false
    yaw_max_deg_s: 80.0
