.per-bab4-panel{margin:12px 0;border:1px solid rgba(85,184,255,.28);border-radius:12px;padding:12px;background:linear-gradient(180deg,rgba(25,78,91,.18),rgba(3,12,14,.24))}
.per-bab4-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:start}.per-bab4-head b{font-size:14px}.per-bab4-head p{margin:5px 0 0;color:var(--muted);font-size:10px;line-height:1.45;max-width:900px}.per-bab4-live{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.per-bab4-live span{border:1px solid var(--border2);border-radius:8px;padding:6px 8px;font:9px ui-monospace;color:var(--muted)}.per-bab4-live b{color:var(--text);font-size:9px}
.per-bab4-controls{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:8px;align-items:end;margin-top:12px}.per-bab4-controls label{display:grid;gap:4px;font-size:8px;color:var(--muted)}.per-bab4-controls label.wide{grid-column:span 2}.per-bab4-controls input,.per-bab4-controls select{height:36px;border:1px solid var(--border2);border-radius:8px;background:var(--input);color:var(--text);padding:5px 8px}.per-bab4-actions{display:flex;gap:7px;flex-wrap:wrap;grid-column:1/-1}.per-bab4-note{grid-column:span 3;border:1px solid var(--border);border-radius:8px;padding:9px}.per-bab4-note b,.per-bab4-note span{display:block}.per-bab4-note span{margin-top:3px;color:var(--muted);font-size:9px;line-height:1.45}
.per-bab4-progress{display:flex;flex-direction:column;gap:6px;margin-top:10px}.per-bab4-progress-row{display:grid;grid-template-columns:110px repeat(5,minmax(70px,1fr));gap:5px;align-items:center}.per-bab4-progress-row>b{font-size:9px}.per-bab4-progress span{display:inline-flex;justify-content:space-between;gap:8px;border:1px solid var(--border);border-radius:7px;padding:6px 8px;font:8px ui-monospace;color:var(--muted)}.per-bab4-progress span.done{border-color:rgba(54,230,161,.45);color:var(--green)}.per-bab4-progress em{font-style:normal;font-weight:800}
#perBab4SummaryCanvas{display:block;width:100%;height:220px;margin-top:10px;border:1px solid var(--border);border-radius:9px;background:#071113}.per-bab4-detection-overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:4}
.per-lane-point-cards{display:grid;grid-template-columns:minmax(220px,1.4fr) repeat(4,minmax(110px,1fr));gap:7px;margin:10px 0}.per-lane-point-note{border:1px solid rgba(85,184,255,.25);border-radius:8px;padding:8px;background:rgba(85,184,255,.04)}.per-lane-point-note b,.per-lane-point-note span{display:block}.per-lane-point-note span{font-size:8px;color:var(--muted);line-height:1.4;margin-top:3px}.per-lane-point-cards button{min-width:0;border:1px solid var(--border2);border-radius:8px;background:var(--input);color:var(--text);padding:7px;text-align:left;cursor:pointer}.per-lane-point-cards button:hover,.per-lane-point-cards button:focus-visible{border-color:var(--green)}.per-lane-point-cards button b{display:block;color:var(--green);font:900 11px ui-monospace}.per-lane-point-cards button span{display:block;font-size:8px;margin:2px 0}.per-lane-point-cards button code{display:block;color:var(--muted);font:8px ui-monospace;white-space:nowrap}
@media(max-width:1000px){.per-bab4-head{grid-template-columns:1fr}.per-bab4-live{justify-content:flex-start}.per-bab4-controls{grid-template-columns:repeat(2,minmax(120px,1fr))}.per-bab4-note,.per-bab4-controls label.wide{grid-column:1/-1}.per-lane-point-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.per-lane-point-note{grid-column:1/-1}.per-bab4-progress-row{grid-template-columns:1fr repeat(5,minmax(48px,1fr))}}
@media(max-width:620px){.per-bab4-controls{grid-template-columns:1fr}.per-bab4-controls label.wide,.per-bab4-note{grid-column:auto}.per-bab4-progress-row{grid-template-columns:1fr 1fr}.per-bab4-progress-row>b{grid-column:1/-1}.per-lane-point-cards{grid-template-columns:1fr}#perBab4SummaryCanvas{height:190px}}

