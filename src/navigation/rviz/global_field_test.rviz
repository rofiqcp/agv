Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
      Enabled: true
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
      Enabled: true
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/Odometry
      Name: Global Test GNSS Map Raw
      Enabled: true
      Topic:
        Value: /global_test/gnss_map
      Keep: 100
      Shape: Arrow
      Covariance:
        Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Global Test Filtered Map
      Enabled: true
      Topic:
        Value: /global_test/filtered_map
      Keep: 100
      Shape: Arrow
      Covariance:
        Value: true
  Enabled: true
  Global Options:
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Value: true
Window Geometry:
  Height: 900
  Width: 1400
