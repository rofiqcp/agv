# Sensor ownership: GNSS -> vx/COG; IMU -> relative inertial yaw+gyro-z;
# NEO3 IST8310 + Yahboom magnetometer -> independently gated absolute map yaw.
# Local EKF owns odom->base_footprint; LocalizationCore alone owns map->odom.
ekf_filter_node_odom:
  ros__parameters:
    # Mini-PC CPU profile: IMU publish efektif ~10 Hz dan Nav2 controller 8 Hz.
    # 10 Hz menjaga estimator di atas controller rate tanpa deadline miss saat
    # YOLOPv2 CPU inference aktif bersamaan.
    frequency: 10.0
    sensor_timeout: 0.25
    two_d_mode: true
    transform_time_offset: 0.0
