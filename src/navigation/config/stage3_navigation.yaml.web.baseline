stage3_navigation:
  ros__parameters:
    commissioning_mode_default: false
    commissioning_speed_cap_mps: 1.0
    require_camera_metric_for_production: true
    require_collision_monitor_for_production: true
    require_trajectory_safety_for_production: true
    require_mppi_profile_for_production: true
    require_fault_injection_for_production: true
    mppi_profile_calibration_valid: false
    mppi_profile_calibration_profile: ''
    mppi_profile_calibration_saved_at: ''
    mppi_profile_calibration_sample_count: 0
    mppi_profile_velocity_rmse_mps: 0.0
    mppi_profile_steering_rmse_rad: 0.0
    mppi_profile_yaw_rate_rmse_rps: 0.0
    velocity_smoother_closed_loop_certified: false
    trajectory_safety_calibration_valid: false
    trajectory_safety_calibration_saved_at: ''
    collision_monitor_calibration_valid: false
    collision_monitor_calibration_saved_at: ''
    fault_injection_calibration_valid: false
    fault_injection_calibration_saved_at: ''
    production_autonomy_certified: false
    production_autonomy_certified_at: ''
    stage3_min_tuning_samples: 60
    stage3_max_velocity_rmse_mps: 0.08
    stage3_max_steering_rmse_rad: 0.12
    stage3_max_yaw_rate_rmse_rps: 0.15
    stage3_max_odom_jitter_sec: 0.02
    stage3_min_odom_rate_hz: 20.0
    mppi_profile_evidence_file: ''
    mppi_profile_evidence_sha256: ''
    velocity_smoother_closed_loop_evidence_file: ''
    velocity_smoother_closed_loop_evidence_sha256: ''
    trajectory_safety_evidence_file: ''
    trajectory_safety_evidence_sha256: ''
    collision_monitor_evidence_file: ''
    collision_monitor_evidence_sha256: ''
    fault_injection_evidence_file: ''
    fault_injection_evidence_sha256: ''
