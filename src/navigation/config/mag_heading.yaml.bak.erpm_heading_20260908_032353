mag_heading_fusion:
  ros__parameters:
    imu_topic: /imu/data
    imu_mag_topic: /imu/mag
    neo3_mag_topic: /neo3/mag
    map_yaw_topic: /localization/map_yaw_from_enu
    imu_heading_topic: /imu/mag_heading_fusion
    neo3_heading_topic: /neo3/mag_heading_fusion
    output_frame: map

    # Tilt compensation uses roll/pitch from the Yahboom IMU, while yaw itself
    # remains independent: raw Yahboom magnetometer and NEO3 IST8310 are two
    # separate absolute-heading observations.
    tilt_timeout_sec: 0.75
    max_tilt_rad: 0.7853981634
    magnetic_declination_rad: 0.0

    # Earth-field sanity gate. Commissioning can tighten this after a clean
    # outdoor baseline is recorded.
    min_field_norm_ut: 15.0
    max_field_norm_ut: 100.0

    # ROS ENU yaw = 90deg - magnetic-bearing-in-body for forward-X/left-Y.
    # Yahboom retains its existing measured mounting offset; NEO3 assumes its
    # arrow/X axis is aligned with vehicle forward and must be field-verified.
    imu_mag_yaw_sign: -1.0
    imu_mag_yaw_offset_rad: 1.5451826276
    neo3_mag_yaw_sign: -1.0
    neo3_mag_yaw_offset_rad: 1.5707963268

    # Independent covariance keeps neither magnetometer stronger than qualified
    # GNSS COG by default. The NEO3 value is slightly tighter than Yahboom.
    imu_heading_variance_rad2: 0.08
    neo3_heading_variance_rad2: 0.06
    max_heading_rate_rps: 3.0
    rate_gate_margin_rad: 0.35
    enable_imu_mag_heading: true
    enable_neo3_mag_heading: true
