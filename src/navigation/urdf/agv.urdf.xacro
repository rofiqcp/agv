<?xml version="1.0"?>
<robot name="ackermann_atv_blueprint"
       
  xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Target coordinate convention:
      +X forward, +Y left, +Z up (REP-103)
      base_link at the geometric center between both axles and both sides

    Sensor-frame options default to false because the supplied project snapshot
    already has external static TF publishers for imu_link, gnss_link, and the
    camera optical frame.
  -->
  <xacro:arg name="publish_functional_sensor_frames" default="false"/>
  <xacro:arg name="publish_camera_optical_frame" default="false"/>
  <xacro:include filename="dimensions.xacro"/>
  <xacro:include filename="materials.xacro"/>
  <!-- REP-105 planar hierarchy: EKF owns odom -> base_footprint (z=0).
       RobotModel then rises to physical base_link by base_link_height=0.350 m.
       This keeps tire contact on the map plane instead of 0.35 m below it. -->
  <link name="base_footprint"/>
  <link name="base_link"/>
  <xacro:include filename="chassis.xacro"/>
  <xacro:include filename="steering.xacro"/>
  <xacro:include filename="wheels.xacro"/>
  <xacro:include filename="sensors.xacro"/>
  <xacro:include filename="joints.xacro"/>
</robot>
