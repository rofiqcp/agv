stmf4_hmi_bridge:
  ros__parameters:
    serial_device: auto
    serial_baud: 1000000
    reconnect_sec: 0.50
    telemetry_rate_hz: 20.0
    serial_poll_hz: 1000.0
    command_rate_hz: 30.0
    heartbeat_sec: 5.0
    manual_speed_max_mps: 1.0
    manual_speed_min_pct: 10
    manual_speed_max_pct: 50
    manual_speed_default_pct: 20
    hmi_steer_full_scale_deg: 90.0
    teleop_yaw_max_deg_s: 80.0
    invert_hmi_steering: false
    default_mode: AUTO
    waypoint_file: /home/otomasi/ros/data/hmi_waypoints.tsv
    waypoint_pose_timeout_sec: 2.5
    neo3_sensor_timeout_sec: 2.0
    neo3_gnss_frame_id: gnss_link
    neo3_mag_frame_id: gnss_link
    neo3_mag_sigma_ut: 3.0
    publish_stm32_gnss: true
    vesc_transport_timeout_sec: 2.0
    # Internal motor UART only. Host USB CDC serial_baud above always remains 1 Mbps.
    vesc_uart_baud_expected: 115200
