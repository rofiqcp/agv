RAW_PREFIXES=("/gnss","/neo3","/neo3pro","/imu","/heading","/odometry","/localization/map_yaw_from_enu")


def iso_utc(ns:int)->str:
    return datetime.fromtimestamp(ns/1e9,tz=timezone.utc).isoformat(timespec="microseconds")

def stamp_ns(msg:Any)->int:
    h=getattr(msg,"header",None); s=getattr(h,"stamp",None) if h is not None else None
    return int(s.sec)*1_000_000_000+int(s.nanosec) if s is not None else 0

def yaw_from_q(q:Any)->float:
    x,y,z,w=map(float,(q.x,q.y,q.z,q.w))
    return norm_angle(math.atan2(2.0*(w*z+x*y),1.0-2.0*(y*y+z*z)))

def roll_pitch_from_q(q:Any)->Tuple[float,float]:
    x,y,z,w=map(float,(q.x,q.y,q.z,q.w))
    roll=math.atan2(2*(w*x+y*z),1-2*(x*x+y*y)); s=2*(w*y-z*x)
    pitch=math.copysign(math.pi/2,s) if abs(s)>=1 else math.asin(s)
    return roll,pitch

def sha256_file(path:Path)->str:
    h=hashlib.sha256()
    with path.open("rb") as f:
        for b in iter(lambda:f.read(1<<20),b""): h.update(b)
    return h.hexdigest()

def git_head(path:Path)->str:
    try:return subprocess.check_output(["git","-C",str(path),"rev-parse","HEAD"],text=True,stderr=subprocess.DEVNULL).strip()
    except Exception:return ""

