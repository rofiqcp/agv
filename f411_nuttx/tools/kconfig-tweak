#!/usr/bin/env python3
"""Tiny compatibility wrapper for NuttX 12.12 sethost.sh.
Supports only the --file/--enable/--disable operations used by that script.
"""
import argparse
from pathlib import Path

p = argparse.ArgumentParser()
p.add_argument('--file', required=True)
g = p.add_mutually_exclusive_group(required=True)
g.add_argument('--enable')
g.add_argument('--disable')
a = p.parse_args()
path = Path(a.file)
lines = path.read_text().splitlines()
sym = a.enable or a.disable
needle = sym + '='
notset = '# ' + sym + ' is not set'
lines = [x for x in lines if not (x.startswith(needle) or x == notset)]
lines.append(f'{sym}=y' if a.enable else notset)
path.write_text('\n'.join(lines) + '\n')
