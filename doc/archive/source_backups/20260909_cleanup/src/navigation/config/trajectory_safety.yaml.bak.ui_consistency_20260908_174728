trajectory_safety_supervisor:
  ros__parameters:
    nav_cmd_topic: /cmd_vel_nav_raw
    perception_advisory_topic: /cmd_vel/perception_advisory
    output_cmd_topic: /cmd_vel/autonomy_integrated
    global_plan_topic: /plan
    local_plan_topic: /controller_server/transformed_global_plan
    map_pose_topic: /localization/pose_estimator_map
    odom_topic: /odometry/filtered
    candidate_obstacle_topic: /perception/object_points
    path_relevant_obstacle_topic: /perception/path_relevant_points
    planning_relevant_obstacle_topic: /perception/planning_relevant_points
    drivable_boundary_topic: /perception/drivable_boundary_points
    avoidance_hint_topic: /navigation/avoidance_hint
    lane_state_topic: /perception/lane_safety_state
    lane_control_state_topic: /perception/lane_control_state
    camera_connected_topic: /perception/camera_connected
    camera_health_topic: /perception/camera_healthy
    emergency_stop_topic: /perception/emergency_stop
    perception_performance_topic: /perception/performance
    state_topic: /navigation/trajectory_safety_state
    control_rate_hz: 20.0
    status_log_period_sec: 1.0
    nav_cmd_timeout_sec: 0.6
    advisory_timeout_sec: 0.5
    plan_timeout_sec: 3.0
    pose_timeout_sec: 0.6
    obstacle_timeout_sec: 0.9
    lane_timeout_sec: 0.75
    drivable_timeout_sec: 0.75
    perception_performance_timeout_sec: 2.0

    # Launch overrides metric_obstacle_safety_enabled from physical calibration state.
    metric_obstacle_safety_enabled: false
    # Commissioning-only bypass; never default ON. Global E-stop/ESC watchdog remain active.
    commissioning_bypass_enabled: true
    latency_compensation_enabled: true
    perception_latency_fallback_sec: 1.0
    latency_safety_margin_sec: 0.15
    latency_distance_margin_m: 0.25
    braking_deceleration_mps2: 1.0
    max_dynamic_stop_distance_m: 2.5
    vehicle_width_m: 0.6
    trajectory_lateral_margin_m: 0.25
    planning_lateral_margin_m: 0.65
    planning_min_forward_m: 0.15
    planning_max_abs_lateral_m: 2.6
    path_horizon_m: 4.0
    command_collision_horizon_m: 2.0
    command_collision_sample_step_m: 0.05
    command_collision_lateral_margin_m: 0.2
    immediate_command_hard_stop_m: 0.65
    hard_stop_path_distance_m: 0.9
    slow_path_distance_m: 2.2
    minimum_slow_speed_scale: 0.35
    avoidance_side_margin_m: 0.25
    avoidance_boundary_lookup_tolerance_m: 0.28
    avoidance_speed_mps: 0.18
    require_drivable_space_for_avoidance: true
    critical_lane_speed_mps: 0.1
    warning_lane_speed_mps: 0.2
    lane_advisory_blend: 1.0
    lane_safety_enabled: false
    maximum_yaw_rate_rps: 0.688498701004
    require_plan_when_moving: true
    require_camera_connected: true
    require_camera_health: true
    require_obstacle_stream_when_moving: true
    stop_on_lane_lost: false
    use_local_plan_when_available: true
    minimum_turning_radius_m: 1.452435565298
